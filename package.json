{
  "name": "rabblebabble",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config src/vite.config.mjs --mode service",
    "dev:byok": "vite --config src/vite.config.mjs --mode byok",
    "build": "npm run build:service",
    "build:service": "tsc --noEmit && vite build --config src/vite.config.mjs --mode service",
    "build:byok": "tsc --noEmit && vite build --config src/vite.config.mjs --mode byok",
    "preview": "vite preview --config src/vite.config.mjs --mode service",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
