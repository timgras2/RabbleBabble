{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rabblebabble",
	"main": "worker/src/index.ts",
	"compatibility_date": "2026-09-05",
	// One origin only. Leaving workers.dev on keeps a second hostname serving the
	// same app, and that copy is subtly broken: requireSameSite rejects its
	// mismatched Origin, and the __Host- session cookie set on rabblebabble.cc
	// does not apply to it. Sign-in would appear to work and then not.
	"workers_dev": false,
	// Created in the dashboard first, then declared here so the deployment lives
	// in git. Attaching it needs an API token with Zone:DNS:Edit and
	// Workers Routes:Edit, not just "Edit Cloudflare Workers".
	"routes": [
		{
			"pattern": "rabblebabble.cc",
			"custom_domain": true
		}
	],
	// Load-bearing for local development. Without it, `wrangler dev` simulates
	// the route above and hands the Worker an Origin of rabblebabble.cc, which
	// no local request can match - every POST 403s on the same-site guard. The
	// port has to be in `host` too: `host: "localhost"` alone strips it, and
	// http://localhost is not http://localhost:8787 to an origin comparison.
	"dev": {
		"host": "localhost:8787",
		"port": 8787
	},
	// One Worker serves the PWA and the API from a single origin. That is what
	// keeps the session cookie first-party, removes CORS entirely, and lets the
	// build-time CSP stay at connect-src 'self'. Asset requests are free and do
	// not invoke the Worker; only /v1/* and /auth/* do.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/v1/*",
			"/auth/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rabblebabble",
			"database_id": "d48dfef9-bf0e-4516-97d7-6e1e57609c9d",
			"migrations_dir": "worker/migrations"
		}
	],
	// Sweeps expired tokens, sessions and rate-limit buckets, and reclaims
	// budget from reservations leaked by a crashed isolate.
	"triggers": {
		"crons": [
			"17 * * * *"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		// Production values. `npm run dev:worker` overrides the first and third
		// with --var, which outranks both .dev.vars and this block.
		"APP_ORIGIN": "https://rabblebabble.cc",
		"SIGNUP_MODE": "invite",
		"EMAIL_MODE": "resend",
		"EMAIL_FROM": "RabbleBabble <login@send.rabblebabble.cc>",
		"MAGIC_LINK_TTL_SECONDS": "900",
		"SESSION_TTL_SECONDS": "31536000",
		"REQUIRE_SAME_DEVICE_LINK": "true",
		"USER_DAILY_AUDIO_SECONDS": "10800",
		"USER_DAILY_TRANSCRIBE_CALLS": "400",
		"USER_DAILY_CHAT_CALLS": "200",
		"GLOBAL_DAILY_SPEND_MICROS": "1000000",
		"TRANSCRIBE_RESERVE_SECONDS": "300",
		"PRICE_TRANSCRIBE_MICROS_PER_HOUR": "40000",
		"PRICE_CHAT_IN_MICROS_PER_MTOK": "75000",
		"PRICE_CHAT_OUT_MICROS_PER_MTOK": "300000",
		"GROQ_BASE_URL": "https://api.groq.com/openai/v1",
		"LOG_LEVEL": "info"
	}
}